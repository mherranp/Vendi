/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "types": []
  },
  "include": ["src/**/*.ts"],
  // `src/lib/testing/` son utilidades de prueba (catálogo de traducción
  // síncrono para los specs de componentes). No se publican en el paquete.
  "exclude": ["**/*.spec.ts", "src/lib/testing/**"]
}
