{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run build:libs",
    "start": "ng serve vendi-app",
    "prestart:portal": "npm run build:libs",
    "start:portal": "ng serve vendi-portal",
    "prestart:tenant": "npm run build:libs",
    "start:tenant": "ng serve vendi-tenant",
    "prestart:admin": "npm run build:libs",
    "start:admin": "ng serve vendi-admin",
    "prebuild": "npm run build:libs",
    "build": "ng build vendi-app",
    "prebuild:portal": "npm run build:libs",
    "build:portal": "ng build vendi-portal",
    "prebuild:tenant": "npm run build:libs",
    "build:tenant": "ng build vendi-tenant",
    "prebuild:admin": "npm run build:libs",
    "build:admin": "ng build vendi-admin",
    "build:libs": "ng build domain && ng build native && ng build ui-kit && ng build data-access && ng build auth",
    "pretest": "npm run build:libs",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codegen:api": "bash ../scripts/codegen-api-client.sh",
    "presync": "npm run build:libs",
    "sync": "ng build vendi-app && cap sync",
    "android": "npm run sync && cap run android",
    "android:studio": "npm run sync && cap open android",
    "ios": "npm run sync && cap run ios",
    "ios:xcode": "npm run sync && cap open ios",
    "cap:doctor": "cap doctor"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "overrides": {
    "js-yaml": "^4.3.0"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "keycloak-js": "^26.2.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.17",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
