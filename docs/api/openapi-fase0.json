  "info": {
    "description": "\nAPI regional de Vendi. Fase 1: fundación + catálogo de productos.\n\nEl negocio (tenant) se resuelve del claim `organization` del token: el alias de\nla Organization de Keycloak **es** el identificador del negocio. Un usuario que\npertenece a varios negocios indica cuál con la cabecera `X-Tenant-Id`, y solo\npuede elegir entre los que ya trae su token.\n",
    "title": "Vendi API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/platform/tenants": {
      "get": {
        "operationId": "listar_tenants_api_v1_platform_tenants_get",
        "parameters": [
          {
            "in": "query",
            "name": "skip",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Skip",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "incluir_eliminados",
            "required": false,
            "schema": {
              "default": false,
              "title": "Incluir Eliminados",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedList_TenantSalida_"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Falta el token o no es válido"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "El token no trae el permiso platform:admin"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Listar negocios",
        "tags": [
          "plataforma"
        ]
      },
      "post": {
        "description": "Crea el negocio y su Organization en Keycloak, en ese orden y con compensación.\n\nSi Keycloak falla, no queda fila: se deshace la transacción y sube un error\ntipado (502 con sobre estándar), no un 500 con traza.\n\nDos negocios pueden llamarse igual: el nombre no es identidad. Ver la nota\nde `create_organization` sobre por qué el `name` de la Organization es el\nUUID y no el nombre comercial.",
        "operationId": "crear_tenant_api_v1_platform_tenants_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TenantCrear"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantSalida"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Falta el token o no es válido"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "El token no trae el permiso platform:admin"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Keycloak no pudo crear la organización"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Dar de alta un negocio",
        "tags": [
          "plataforma"
        ]
      }
    },
    "/api/v1/platform/tenants/{tenant_id}": {
      "delete": {
        "description": "Borrado lógico de la fila + borrado de la Organization en Keycloak.\n\nLa fila sobrevive para la auditoría y para que su `id` —que fue alias de una\nOrganization— no se reutilice jamás.",
        "operationId": "eliminar_tenant_api_v1_platform_tenants__tenant_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "tenant_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Tenant Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
