{
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "code": {
            "default": "ERROR",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "success": {
            "default": false,
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "EstadoTenant": {
        "description": "Estados de un negocio. Sin tildes ni eñes: viajan en JSON y en URLs.",
        "enum": [
          "activo",
          "suspendido",
          "eliminado"
        ],
        "title": "EstadoTenant",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PagedList_TenantSalida_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TenantSalida"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "skip": {
            "title": "Skip",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "skip",
          "limit"
        ],
        "title": "PagedList[TenantSalida]",
        "type": "object"
      },
      "TenantActualizar": {
        "description": "Todo opcional: es un PATCH. `None` significa \"no lo toques\".",
        "properties": {
          "estado": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EstadoTenant"
              },
              {
                "type": "null"
              }
            ]
          },
          "nombre": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nombre"
          }
        },
        "title": "TenantActualizar",
        "type": "object"
      },
      "TenantCrear": {
        "properties": {
          "nombre": {
            "maxLength": 120,
            "minLength": 2,
            "title": "Nombre",
            "type": "string"
          }
        },
        "required": [
          "nombre"
        ],
        "title": "TenantCrear",
        "type": "object"
      },
      "TenantSalida": {
        "properties": {
          "created_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "estado": {
            "$ref": "#/components/schemas/EstadoTenant"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kc_org_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kc Org Id"
          },
          "nombre": {
            "title": "Nombre",
            "type": "string"
          }
        },
        "required": [
          "id",
          "nombre",
          "estado"
        ],
        "title": "TenantSalida",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "\nAPI regional de Vendi. Fase 0: fundación.\n\nEl negocio (tenant) se resuelve del claim `organization` del token: el alias de\nla Organization de Keycloak **es** el identificador del negocio. Un usuario que\npertenece a varios negocios indica cuál con la cabecera `X-Tenant-Id`, y solo\npuede elegir entre los que ya trae su token.\n",
    "title": "Vendi API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/platform/tenants": {
      "get": {
        "operationId": "listar_tenants_api_v1_platform_tenants_get",
        "parameters": [
          {
            "in": "query",
            "name": "skip",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Skip",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "incluir_eliminados",
            "required": false,
            "schema": {
              "default": false,
              "title": "Incluir Eliminados",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedList_TenantSalida_"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Falta el token o no es válido"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "El token no trae el permiso platform:admin"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Listar negocios",
        "tags": [
          "plataforma"
        ]
      },
      "post": {
        "description": "Crea el negocio y su Organization en Keycloak, en ese orden y con compensación.\n\nSi Keycloak falla, no queda fila: se deshace la transacción y sube un error\ntipado (502 con sobre estándar), no un 500 con traza.\n\nDos negocios pueden llamarse igual: el nombre no es identidad. Ver la nota\nde `create_organization` sobre por qué el `name` de la Organization es el\nUUID y no el nombre comercial.",
        "operationId": "crear_tenant_api_v1_platform_tenants_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TenantCrear"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantSalida"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Falta el token o no es válido"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "El token no trae el permiso platform:admin"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Keycloak no pudo crear la organización"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Dar de alta un negocio",
        "tags": [
          "plataforma"
        ]
      }
    },
    "/api/v1/platform/tenants/{tenant_id}": {
      "delete": {
        "description": "Borrado lógico de la fila + borrado de la Organization en Keycloak.\n\nLa fila sobrevive para la auditoría y para que su `id` —que fue alias de una\nOrganization— no se reutilice jamás.",
        "operationId": "eliminar_tenant_api_v1_platform_tenants__tenant_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "tenant_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Tenant Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
