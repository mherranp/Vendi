            "description": "El negocio está suspendido"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "El negocio ya no existe"
          }
        },
        "summary": "El negocio de la sesión actual",
        "tags": [
          "negocio"
        ]
      }
