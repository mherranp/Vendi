# =============================================================================
# .env.example — plantilla de configuración de Vendi.
#
#   cp .env.example .env      # y cambia TODAS las contraseñas antes de nada
#
# El archivo `.env` real está en .gitignore y nunca se commitea. Este ejemplo
# sí, así que aquí solo hay valores de desarrollo evidentes: cualquier valor
# de este archivo que aparezca en un despliegue accesible desde internet es un
# incidente de seguridad, no un descuido. `scripts/verify-setup.sh` lo
# comprueba cuando APP_ENV=production y falla en rojo.
# =============================================================================

# --- General ---------------------------------------------------------------
APP_ENV=development

# Dominio base de toda la flota. Cambiarlo aquí renombra los hosts de Traefik
# (api.*, accounts.*, grafana.*) y los redirect URIs del realm de Keycloak.
# En desarrollo se resuelve con dnsmasq (scripts/setup-dnsmasq.sh) y los
# certificados los emite mkcert (scripts/setup-certs.sh).
BASE_DOMAIN=vendi.co

# --- PostgreSQL ------------------------------------------------------------
# Superusuario del clúster. Solo lo usan el init y el mantenimiento; ni la API
# ni las migraciones se conectan con él.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_postgres_dev
POSTGRES_DB=postgres

# Los dos roles del modelo RLS (informe 2026-07-22-verificacion-rls.md):
#   vendi_platform → BYPASSRLS, dueño de las tablas, DSN de Alembic y del worker
#   vendi_app      → sin BYPASSRLS, DSN de la API
VENDI_PLATFORM_DB_PASSWORD=cambiar_platform_dev
VENDI_APP_DB_PASSWORD=cambiar_app_dev

# --- Redis -----------------------------------------------------------------
REDIS_PASSWORD=cambiar_redis_dev

# --- RabbitMQ --------------------------------------------------------------
RABBITMQ_USER=vendi
RABBITMQ_PASSWORD=cambiar_rabbit_dev

# --- MinIO -----------------------------------------------------------------
# Un solo bucket por región con prefijo {tenant_id}/ (ADR-016): decenas de
# miles de buckets del plan gratuito no escalan en S3.
MINIO_ACCESS_KEY=vendi
MINIO_SECRET_KEY=cambiar_minio_dev
MINIO_BUCKET=vendi-co-media

# --- Keycloak --------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=cambiar_kc_dev
# Secreto del cliente confidencial `vendi-backend`. Se sustituye dentro de
# infra/keycloak/realm-vendi-co.json durante el import (hace falta el flag
# KC_SPI_IMPORT_SINGLE_FILE_REPLACE_PLACEHOLDERS, ya puesto en el compose).
# Rotarlo en producción implica cambiarlo TAMBIÉN en Keycloak: el import no se
# vuelve a ejecutar sobre un realm existente (ver infra/keycloak/README.md).
VENDI_BACKEND_CLIENT_SECRET=cambiar_backend_secret_dev
# Secreto del cliente confidencial `vendi-provisioning`, el ÚNICO que lleva
# manage-realm. Mitigación de D-02: la API general usa `vendi-backend` (solo
# manage-users) y este solo lo toca el camino de alta y baja de negocios, que
# es el que necesita la API de Organizations. Tiene que ser DISTINTO del
# anterior: dos credenciales con el mismo valor son una credencial.
VENDI_PROVISIONING_CLIENT_SECRET=cambiar_provisioning_secret_dev
# Audiencia que la API exige en el claim `aud` del token. La emite el client
# scope `vendi-audiencia` del realm (mapper de audiencia) en los tokens de
# `vendi-web` y `vendi-admin`. Vaciarla APAGA la comprobación, y entonces
# cualquier token firmado por el realm sirve contra la API aunque se emitiera
# para otro público —por ejemplo el de la consola de cuenta de Keycloak, que un
# usuario obtiene sin pasar por ninguna aplicación de Vendi.
KEYCLOAK_AUDIENCE=vendi-backend

# --- API -------------------------------------------------------------------
# ¿Se publican /docs, /redoc y /openapi.json? El compose de desarrollo lo pone
# a true; el defecto del código es false y en producción no se declara, así que
# las rutas ni se registran (404 real). Ver backend/services/api/app/settings.py.
DOCS_PUBLICOS=true

# --- Observabilidad --------------------------------------------------------
# Credencial de `/metrics` de la API. Prometheus la manda como
# `Authorization: Bearer` (el entrypoint del contenedor la materializa en un
# archivo porque Prometheus no expande variables de entorno en su config).
#
# La ruta NO es pública: el router `api` de Traefik enruta por Host, no por
# path, así que sin esto la exposición de Prometheus —mapa de rutas internas,
# contadores de error por endpoint, identificadores de negocio— quedaría
# servida en https://api.<dominio>/metrics a cualquiera. Sin valor, la ruta
# responde 503 y no se abre.
METRICS_TOKEN=cambiar_metrics_token_dev

# --- Grafana ---------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=cambiar_grafana_dev

# --- Worker ----------------------------------------------------------------
# Segundos entre latidos. El healthcheck del compose considera muerto al
# worker si el archivo de latido supera 3 intervalos sin tocarse.
WORKER_HEARTBEAT_SECONDS=30

# --- Siembra de desarrollo (scripts/seed.sh) -------------------------------
# Contraseñas de los usuarios que crea la siembra. SIN valor por defecto en el
# código: una contraseña por defecto en un script de siembra acaba siendo una
# contraseña en producción el día que alguien lo ejecute donde no debía.
#   admin@vendi.co        -> consola de plataforma (permiso platform:admin)
#   dueno@demo.vendi.co   -> dueño del negocio demo «Tienda Don Carlos»
SEED_ADMIN_PASSWORD=cambiar_admin_seed_dev
SEED_DUENO_PASSWORD=cambiar_dueno_seed_dev

# --- Borde (Traefik) -------------------------------------------------------
# Interfaz donde el borde publica 80/443. Por defecto SOLO loopback: en
# desarrollo el stack no tiene por qué quedar expuesto a la red del café. Para
# probar desde el móvil en la LAN, ponlo en 0.0.0.0 (y sabe lo que haces).
# El override de producción publica en 0.0.0.0 por su cuenta.
TRAEFIK_BIND=127.0.0.1

# --- TLS / ACME (solo producción) ------------------------------------------
# ACME_ENABLED=false → los certificados los pone mkcert (scripts/setup-certs.sh)
#                      y los routers usan `tls: {}`.
# ACME_ENABLED=true  → el entrypoint de Traefik declara el resolver
#                      `letsencrypt` y TODOS los routers pasan a
#                      `certResolver: letsencrypt`. Exige ACME_EMAIL.
# ACME_STAGING=true  → CA de pruebas de Let's Encrypt (empieza SIEMPRE aquí:
#                      la CA de producción limita a 5 fallos por hora y cuenta).
#
# El camino completo se verifica sin exponer nada a internet con
# `bash scripts/spikes/acme-pebble-spike.sh` (CA ACME local).
ACME_ENABLED=false
ACME_STAGING=true
ACME_EMAIL=
# Solo para pruebas contra una CA ACME local; en producción se deja vacío y
# ACME_STAGING decide la URL:
#   ACME_CA_SERVER=
#   LEGO_CA_CERTIFICATES=

# --- Trazas (opcional) -----------------------------------------------------
# Vacío desactiva el SDK de OpenTelemetry por completo (coste cero).
OTEL_EXPORTER_OTLP_ENDPOINT=
